# Set Jwt__Key and SMTP settings through environment variables or a secret provider.
@baseUrl = http://localhost:5000
@testEmail = test.user@example.com
@testPassword = GoodPass123!
@confirmationUserId = paste-user-id-from-confirmation-email
@confirmationToken = paste-url-decoded-token-from-confirmation-email
@resetUserId = paste-user-id-from-reset-email
@resetToken = paste-token-from-reset-email
@inventoryItemId = 1
@secondInventoryItemId = 2
@cartQuantity = 1

### Register a user
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### If registration mail is unavailable, resend after SMTP is configured
POST {{baseUrl}}/api/auth/resend-confirmation
Content-Type: application/json

{
  "email": "{{testEmail}}"
}

### Confirm email using values from the confirmation email
GET {{baseUrl}}/api/auth/confirm-email?userId={{confirmationUserId}}&token={{confirmationToken}}
Accept: application/json

### Login and retrieve a JWT after confirming the email
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

@accessToken = {{login.response.body.accessToken}}

### Request password-reset instructions
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{testEmail}}"
}

### Reset password using values from the reset email
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "userId": "{{resetUserId}}",
  "token": "{{resetToken}}",
  "newPassword": "NewStrongPass123!"
}

### Anonymous request is rejected (expected 401)
GET {{baseUrl}}/api/cart
Accept: application/json

### List inventory
GET {{baseUrl}}/api/inventory
Accept: application/json
Authorization: Bearer {{accessToken}}

### Get or create this user's persisted cart
GET {{baseUrl}}/api/cart
Accept: application/json
Authorization: Bearer {{accessToken}}

### Add inventory item to cart
POST {{baseUrl}}/api/cart/items
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "inventoryItemId": {{inventoryItemId}},
  "quantity": {{cartQuantity}}
}

### Add another item to cart (optional)
POST {{baseUrl}}/api/cart/items
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "inventoryItemId": {{secondInventoryItemId}},
  "quantity": 1
}

### Review the persisted cart
GET {{baseUrl}}/api/cart
Accept: application/json
Authorization: Bearer {{accessToken}}

### Checkout: validates and decrements stock transactionally, creates an order
# @name checkout
POST {{baseUrl}}/api/orders
Authorization: Bearer {{accessToken}}

### Fetch the order created by checkout
GET {{checkout.response.headers.Location}}
Accept: application/json
Authorization: Bearer {{accessToken}}

### List this user's orders (paginated)
GET {{baseUrl}}/api/orders?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{accessToken}}

### Remove an item from the cart
DELETE {{baseUrl}}/api/cart/items/{{inventoryItemId}}
Authorization: Bearer {{accessToken}}

### Manager-only inventory write (expected 403 for regular users)
POST {{baseUrl}}/api/inventory
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Test Pallet",
  "quantity": 8,
  "location": "Warehouse A"
}
